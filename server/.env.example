# ---- Required ----
OPENAI_API_KEY=your_openai_key
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---- Access control ----
# Shared token required by every /api route. LEAVE THIS SET IN PRODUCTION:
# without it the API is fully open and anyone with the URL can spend your
# OpenAI credits. Generate one with: openssl rand -hex 32
APP_ACCESS_TOKEN=

# Comma-separated list of allowed browser origins (your Vercel URL).
# Empty means allow all — do not leave empty in production.
ALLOWED_ORIGINS=

# ---- Server ----
PORT=8080
# Storage root. On Render set this to your mounted disk, e.g. /data
APP_STORAGE_DIR=

# ---- Processing ----
# Images generated concurrently. Set to 1 for strict one-by-one.
# Each concurrent image holds a decoded bitmap in memory; 4-6 suits 1GB RAM.
WORKER_CONCURRENCY=6

# ---- Image generation ----
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
# edit = direct image-to-image (best identity preservation)
# generate_from_reference = analyze identity, then generate a new portrait
IMAGE_TRANSFORM_MODE=edit
IDENTITY_ANALYSIS_ENABLED=1
IDENTITY_ANALYSIS_MODEL=gpt-4o-mini
# Optional full prompt override
# VECTORIZE_PROMPT=

# ---- Timeouts and retries ----
OPENAI_TIMEOUT_SECONDS=120
EXTERNAL_MAX_RETRIES=5
DOWNLOAD_TIMEOUT_SECONDS=30
DOWNLOAD_MAX_RETRIES=4
MAX_DOWNLOAD_BYTES=20971520

# ---- Misc ----
CLOUDINARY_FOLDER_PREFIX=vectorize_jobs
JOB_TTL_SECONDS=604800
